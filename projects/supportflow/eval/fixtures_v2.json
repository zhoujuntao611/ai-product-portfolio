      "documents": [
        {
          "id": "KB-001",
          "title": "账户登录与密码重置",
          "category": "access",
          "version": "2.1",
          "updated": "2026-09-18",
          "active": true,
          "keywords": [
            "密码",
            "登录",
            "登入",
            "忘记",
            "重置",
            "password",
            "login",
            "验证码",
            "邮箱收不到"
          ],
          "statements": [
            "在登录页选择“忘记密码”，使用账户绑定邮箱接收重置链接；链接有效期为 30 分钟。",
            "若收不到邮件，请检查垃圾邮件和邮箱拼写；仍未收到时向客服提供账号邮箱与问题发生时间。",
            "客服不会索取密码、完整验证码或访问令牌。"
          ],
          "source": "合成资料：云桥协作客服政策手册 / 账户登录与密码重置",
          "region": "all",
          "effective_from": "2026-09-18",
          "effective_to": null
        },
        {
          "id": "KB-002",
          "title": "开票流程与处理时效",
          "category": "invoice",
          "version": "1.4",
          "updated": "2026-09-10",
          "active": true,
          "keywords": [
            "发票",
            "开票",
            "invoice",
            "抬头",
            "税号"
          ],
          "statements": [
            "管理员可在“账单 → 已支付订单 → 申请发票”填写发票抬头与税号。",
            "开票申请通常在 3 个工作日内处理；资料错误时需要更正后重新提交。",
            "发票信息变更须由账单管理员操作，客服草稿不会代替账户权限校验。"
          ],
          "source": "合成资料：云桥协作客服政策手册 / 开票流程与处理时效",
          "region": "all",
          "effective_from": "2026-09-10",
          "effective_to": null
        },
        {
          "id": "KB-003",
          "title": "大陆地区标准订阅退款规则",
          "category": "refund",
          "region": "mainland",
          "version": "3.0",
          "updated": "2026-10-01",
          "active": true,
          "keywords": [
            "退款",
            "退费",
            "返款",
            "refund",
            "重复扣款"
          ],
          "statements": [
            "大陆地区标准订阅可在首次付款后 7 个自然日内提交退款申请，审批结果由人工核验订单、合同及使用情况后决定。",
            "重复扣款需提供订单号和扣款时间；请勿提交完整银行卡号。",
            "企业定制合同的退款条件以已签署合同为准，需要转交客户经理核验。"
          ],
          "source": "合成资料：云桥协作客服政策手册 / 大陆地区标准订阅退款规则",
          "effective_from": "2026-10-01",
          "effective_to": null
        },
        {
          "id": "KB-004",
          "title": "海外地区标准订阅退款规则",
          "category": "refund",
          "region": "overseas",
          "version": "2.2",
          "updated": "2026-10-01",
          "active": true,
          "keywords": [
            "退款",
            "退费",
            "refund",
            "重复扣款"
          ],
          "statements": [
            "海外地区标准订阅可在首次付款后 14 个自然日内提交退款申请，审批结果由人工核验订单、合同及使用情况后决定。",
            "企业定制合同的退款条件以已签署合同为准，需要转交客户经理核验。"
          ],
          "source": "合成资料：云桥协作客服政策手册 / 海外地区标准订阅退款规则",
          "effective_from": "2026-10-01",
