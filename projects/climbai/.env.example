# No key is required. Without an explicitly configured API key the app uses
# transparent, deterministic demo rules; it never claims a model was called.
CLIMBAI_PROVIDER=demo
CLIMBAI_API_KEY=
CLIMBAI_API_BASE=https://api.openai.com/v1
CLIMBAI_MODEL=
# responses, chat (JSON Schema), or chat_json (JSON object, e.g. DeepSeek)
CLIMBAI_API_MODE=responses
# Optional provider extension: enabled / disabled; leave blank for default.
CLIMBAI_THINKING=
CLIMBAI_API_TIMEOUT=25
CLIMBAI_MAX_OUTPUT_TOKENS=1800
CLIMBAI_DB_PATH=backend/data/climbai.sqlite3
CLIMBAI_CHROMA_PATH=backend/data/chroma
# Local hashed character n-grams are a retrieval demo, not model embeddings.
CLIMBAI_RETRIEVAL=hash_demo
CLIMBAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000,https://zhoujuntao611.github.io
