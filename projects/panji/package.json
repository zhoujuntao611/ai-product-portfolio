{
  "name": "panji-miniprogram",
  "version": "0.2.2",
  "private": true,
  "description": "攀迹 · 个人攀岩成长记录微信小程序",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check && npm run test && npm run build && node scripts/verify.mjs",
    "configure": "node scripts/configure.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:wechat": "node scripts/wechat-compile.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "miniprogram-api-typings": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
