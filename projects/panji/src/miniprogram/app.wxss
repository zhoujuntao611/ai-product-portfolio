page{background:#f5f6f2;color:#203e37;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6;box-sizing:border-box}
view,text,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;line-height:1.5;border-radius:22rpx;margin:0;font-weight:600}button::after{border:0}button[disabled]{opacity:.45}button.primary{background:#1e5147;color:#fff;padding:26rpx 30rpx}button.secondary{background:#e7ece6;color:#1e5147;padding:23rpx 30rpx}button.outline{background:transparent;border:2rpx solid #d9dfd6;color:#31584d;padding:20rpx 28rpx}button.danger{background:#f9e9e0;color:#a34c36;padding:22rpx 28rpx}button.link{background:transparent;color:#1e5147;font-size:25rpx;padding:8rpx 0;display:inline-block;font-weight:500}button.small{font-size:24rpx;padding:14rpx 22rpx;border-radius:16rpx}
.page{padding:28rpx 32rpx 64rpx;max-width:1000rpx;margin:auto}.eyebrow{font-size:21rpx;letter-spacing:5rpx;color:#839188;font-weight:600}.page-title{font-size:44rpx;line-height:1.3;font-weight:700;letter-spacing:0;margin:12rpx 0}.subtitle{font-size:25rpx;color:#7b8980}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.wrap{flex-wrap:wrap}.gap{height:30rpx}.card{background:#fff;border:1rpx solid #e7e9e0;border-radius:24rpx;padding:26rpx;margin-bottom:20rpx;box-shadow:0 4rpx 18rpx rgba(30,60,45,.025)}.card-title{font-size:31rpx;font-weight:650}.section-title{font-size:30rpx;font-weight:650;margin:30rpx 0 18rpx}.muted{color:#7b8980;font-size:24rpx}.tiny{font-size:21rpx;color:#8b968e}.accent{color:#cb7b43}.badge{display:inline-block;padding:5rpx 16rpx;background:#edf1e9;color:#52725d;border-radius:10rpx;font-size:21rpx}.badge.warm{background:#fbefdc;color:#a86d34}.badge.error{background:#fae8e0;color:#a8543a}.line{height:1rpx;background:#edf0e8;margin:24rpx 0}.empty{text-align:center;padding:65rpx 28rpx}.empty-mark{width:100rpx;height:100rpx;border-radius:50%;background:#eaf0e6;color:#789272;margin:0 auto 26rpx;display:flex;align-items:center;justify-content:center;font-size:48rpx}.empty-title{font-size:30rpx;font-weight:600;margin-bottom:14rpx}.empty-copy{font-size:25rpx;color:#829084;margin:0 0 30rpx;line-height:1.9}.error-box{padding:28rpx;background:#fbeee6;border-radius:22rpx;margin:20rpx 0;color:#994e38;font-size:26rpx}.notice{padding:20rpx 24rpx;background:#eaf0e5;border-radius:18rpx;color:#647c5e;font-size:23rpx;margin:22rpx 0}.label{font-size:25rpx;font-weight:600;margin:25rpx 0 13rpx}.input,.textarea,.picker{width:100%;padding:24rpx;background:#f6f7f2;border:2rpx solid #e7ebe1;border-radius:18rpx;font-size:28rpx;color:#254c40}.input{height:84rpx}.textarea{height:200rpx;line-height:1.7}.picker{min-height:84rpx}.hint{font-size:22rpx;color:#8a958d;margin-top:10rpx}.actions{display:flex;gap:18rpx;margin-top:26rpx}.actions button{flex:1}.bottom-space{height:30rpx}.metric{font-size:50rpx;font-weight:650;line-height:1.3}.metric-unit{font-size:23rpx;font-weight:400;margin-left:6rpx;color:#829080}.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.stat-box{background:#fff;border:1rpx solid #e6e9df;border-radius:24rpx;padding:26rpx}.stat-label{font-size:23rpx;color:#819080;margin-top:12rpx}.body-copy{white-space:pre-wrap;word-break:break-word;font-size:27rpx;line-height:1.9}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:22rpx 0}.chip{padding:12rpx 24rpx;border:2rpx solid #e0e5d9;border-radius:40rpx;font-size:24rpx;color:#789072;background:transparent}.chip.active{background:#1e5147;color:#fff;border-color:#1e5147}.divider-label{font-size:23rpx;color:#8a978b;letter-spacing:2rpx;margin:24rpx 0 18rpx}.video{width:100%;height:360rpx;border-radius:18rpx;background:#163d34;margin-top:16rpx}.switch-row{padding:22rpx 0;display:flex;align-items:center;justify-content:space-between;gap:16rpx}.list-row{padding:28rpx 0;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eef0e8}.list-row:last-child{border-bottom:0}.arrow{color:#a1ad9e;font-size:30rpx}.inline-link{color:#2c6a54;text-decoration:underline}.spaced{margin-top:20rpx}.warning-copy{color:#ac7147}.sheet{background:#f1f4ec;border-radius:22rpx;padding:26rpx;margin-top:22rpx}.pill-dot{width:12rpx;height:12rpx;background:#d48c55;border-radius:50%;display:inline-block;margin-right:12rpx}

.full-width{width:100%}.form-columns{display:flex;gap:18rpx;align-items:flex-start}.form-columns>view{min-width:0}.fold-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;width:100%;padding:20rpx 0;min-height:88rpx;margin-top:16rpx;background:transparent;border-top:1rpx solid #e7ece3;border-radius:0;color:#526b60;font-size:25rpx;font-weight:500;text-align:left}.fold-symbol{font-size:30rpx;color:#718778}.required-dot{color:#a77751}.input,.textarea,.picker{padding:20rpx;background:#f5f7f2}.subtitle{line-height:1.7}.body-copy{line-height:1.8}.eyebrow{letter-spacing:2rpx}.chips .chip{min-height:68rpx;display:flex;align-items:center;justify-content:center}.link{min-height:64rpx}

.page button.full-width,.page button.add-button{width:100%}.page button.link{width:auto}.page .actions button{width:auto;min-width:0}.page .gym-picker-row button{width:auto;min-width:128rpx}.page .gym-picker-row button.grow{width:100%}

.page button.fold-row{width:100%}
