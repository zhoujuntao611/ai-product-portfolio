.privacy-mask{position:fixed;z-index:9999;inset:0;background:rgba(16,35,29,.45);display:flex;align-items:center;justify-content:center;padding:48rpx}.privacy-dialog{width:100%;max-width:650rpx;background:#fff;border-radius:30rpx;padding:38rpx;color:#203e37;box-sizing:border-box}.privacy-title{font-size:34rpx;font-weight:650;margin-bottom:22rpx}.privacy-copy{font-size:28rpx;line-height:1.8;color:#687c70}.privacy-contract{font-size:26rpx;color:#1e5147;padding:24rpx 0;line-height:1.6}.privacy-actions{display:flex;gap:20rpx;margin-top:16rpx}.privacy-actions button{flex:1;font-size:28rpx;line-height:1.5;padding:22rpx 10rpx;border-radius:18rpx;margin:0}.privacy-actions button::after{border:0}.privacy-decline{background:#eef1e9;color:#54705e}.privacy-agree{background:#1e5147;color:white}
