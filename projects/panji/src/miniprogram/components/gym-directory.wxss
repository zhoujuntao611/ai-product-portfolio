.directory-overview{display:flex;align-items:baseline;justify-content:space-between;padding:25rpx 0 22rpx;color:#64796f}.directory-total{font-size:76rpx;font-weight:650;color:#214b40;line-height:1}.directory-city-count{font-size:26rpx}.directory-categories{display:flex;background:#eaf0e7;border-radius:24rpx;padding:22rpx 0;margin-bottom:28rpx}.directory-categories>view{flex:1;display:flex;justify-content:center;align-items:baseline;gap:12rpx;border-right:1rpx solid #d6dfd2}.directory-categories>view:last-child{border-right:0}.directory-categories text:first-child{font-size:36rpx;font-weight:650}.directory-categories text:last-child{font-size:24rpx;color:#6b7d70}.directory-search{display:flex;align-items:center;gap:16rpx}.directory-search .input{flex:1;height:84rpx;background:#fff;font-size:25rpx}.city-button{padding:20rpx 10rpx 20rpx 0;font-size:27rpx;white-space:nowrap}.directory-result{font-size:24rpx;color:#7b8980;margin:20rpx 0}.directory-group-title{display:flex;align-items:center;gap:20rpx;margin:30rpx 0 18rpx;font-size:29rpx;font-weight:600}.directory-group-title>text:last-child{font-size:23rpx;color:#7b8980;font-weight:400}.directory-city-bar{flex:1;height:6rpx;background:#e8ece2;border-radius:5rpx}.directory-city-bar>view{height:100%;background:#b0c3a6;border-radius:5rpx}.directory-card{padding:26rpx}.directory-address{font-size:24rpx;color:#76867b;margin:10rpx 0 20rpx}.directory-tags{gap:8rpx;flex:1}.directory-add{background:#1e5147;color:#fff;font-size:26rpx;min-width:68rpx;padding:12rpx 18rpx;border-radius:16rpx;margin-left:12rpx}.directory-add.added{background:#edf1e9;color:#52725d;font-size:22rpx}.directory-foot{font-size:22rpx;text-align:center;color:#8a958d;padding:16rpx 0}.directory-card .card-title{font-size:29rpx}
.directory-add{width:76rpx;min-width:76rpx;flex:0 0 76rpx;padding:12rpx 0}.directory-add.added{width:110rpx;flex-basis:110rpx}.directory-add.selecting{width:120rpx;flex-basis:120rpx}.directory-address{word-break:break-all;line-height:1.7}
.directory-result{display:flex;align-items:center;justify-content:space-between}.directory-more{width:100%;margin:28rpx 0 16rpx}
.directory-attribution{margin-top:12rpx;color:#617965;font-size:22rpx}.directory-foot .directory-export{font-size:22rpx;margin-top:4rpx}
.directory-result .directory-reset{font-size:24rpx;padding:0 12rpx;margin:0 0 0 auto}.directory-reset+text{margin-left:16rpx}

.directory-overview{padding:20rpx 0 8rpx}.directory-total{font-size:64rpx}.directory-city-count{font-size:24rpx}.directory-categories{display:flex;align-items:center;gap:16rpx;background:transparent;border-radius:0;padding:4rpx 0;margin-bottom:22rpx;font-size:23rpx;color:#7b8c7f}.directory-categories text{font-size:22rpx!important;color:#b1bcae!important}.city-button{padding:18rpx;background:#e9eee4;border-radius:16rpx;font-size:25rpx}.directory-search{gap:12rpx}.directory-search .input{height:80rpx}.directory-card{padding:24rpx}.directory-card .card-title{font-size:28rpx;line-height:1.5}.directory-address{margin:8rpx 0 15rpx;line-height:1.6}.directory-city-divider{flex:1;height:1rpx;background:#dce4d6}.directory-group-title{margin-top:24rpx}.directory-foot{font-size:21rpx}
.directory-search-input{flex:1;min-width:0;position:relative}.directory-search-input .input{padding-right:64rpx;box-sizing:border-box}.directory-search-clear{position:absolute;right:4rpx;top:0;width:64rpx;height:80rpx;line-height:80rpx;padding:0;background:transparent;color:#87968a;font-size:36rpx}.directory-scope{display:flex;gap:28rpx;align-items:center;margin-top:24rpx;border-bottom:1rpx solid #dce4d6}.directory-scope-item{font-size:26rpx;color:#829083;padding:10rpx 2rpx 17rpx;border-bottom:4rpx solid transparent}.directory-scope-item.active{color:#1e5147;border-bottom-color:#1e5147;font-weight:600}.directory-scope-item text{font-size:22rpx;margin-left:4rpx;font-weight:400}.directory-scope+.chips{margin-top:18rpx}
.directory-personal-error{display:flex;align-items:center;gap:12rpx;font-size:23rpx;line-height:1.6;padding:18rpx 0;color:#8b7257}.directory-personal-error text{flex:1}.directory-personal-error .link{font-size:24rpx;padding:0;flex-shrink:0}
