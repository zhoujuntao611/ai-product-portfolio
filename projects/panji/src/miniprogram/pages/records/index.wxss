.hero{display:flex;align-items:center;gap:24rpx;border-radius:28rpx;background:linear-gradient(120deg,#214f43,#173d35);color:#fff;padding:28rpx;margin:24rpx 0 20rpx}.hero-main{flex:1;min-width:0}.hero-caption{font-size:23rpx;color:#c1d4c7}.hero-stats{margin-top:15rpx;gap:18rpx}.hero-number{font-size:57rpx;font-weight:650;line-height:1.2}.hero-unit{display:block;font-size:21rpx;color:#cbdbcf;margin-top:4rpx}.hero-rule{height:48rpx;width:1rpx;background:#6a9181;opacity:.55}.day-chart{display:flex;align-items:flex-end;gap:9rpx;width:274rpx}.day-column{flex:1;text-align:center;font-size:20rpx;color:#c8d9cc}.day-count{height:24rpx;font-size:18rpx}.day-track{height:64rpx;display:flex;align-items:flex-end;justify-content:center}.day-bar{width:19rpx;background:#b1cfac;border-radius:5rpx 5rpx 1rpx 1rpx}.day-column text{display:block;margin-top:12rpx}.day-column.today text{color:#fff;font-weight:650}.day-column.future{opacity:.35}.add-button{width:100%;box-shadow:0 5rpx 14rpx rgba(30,80,60,.08)}.goal-card{padding:24rpx;background:#eaf0e2;border:1rpx solid #dfe8d9;border-radius:24rpx;margin-top:24rpx}.goal-line{font-size:26rpx;margin:10rpx 0}.search{margin-bottom:20rpx;background:#ecefe7;height:80rpx;font-size:25rpx}.date-label{color:#718277;font-size:23rpx}.session-gym{margin:10rpx 0 15rpx;font-size:29rpx}.session-gym .arrow{float:right}.note-preview{font-size:25rpx;color:#788777;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin-top:16rpx;line-height:1.75}.empty-copy{margin-bottom:0}.session-card{padding:24rpx 26rpx}
