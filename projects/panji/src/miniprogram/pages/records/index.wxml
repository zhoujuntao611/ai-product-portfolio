<view class="page">
  <view class="row between"><view class="page-title">我的攀迹</view><view class="badge" bindtap="mine">{{local ? '本机' : '云端'}}</view></view>
  <view class="hero"><view class="hero-main">
    <view class="hero-caption">本周</view>
    <view class="row hero-stats"><view><text class="hero-number">{{week.sessions}}</text><text class="hero-unit">次训练</text></view><view class="hero-rule"></view><view><text class="hero-number">{{week.minutes}}</text><text class="hero-unit">分钟</text></view></view>
    </view><view class="day-chart"><view wx:for="{{days}}" wx:key="date" class="day-column {{item.future ? 'future' : ''}} {{item.today ? 'today' : ''}}"><view class="day-count">{{item.count || ''}}</view><view class="day-track"><view class="day-bar" style="height:{{item.height}}rpx"></view></view><text>{{item.label}}</text></view></view>
  </view>
  <button class="primary add-button" bindtap="add">＋ 记录一次训练</button>
  <view wx:if="{{error}}" class="error-box">{{error}}<button class="link" bindtap="reload">重新读取</button></view>
  <view wx:if="{{loading}}" class="notice">加载中…</view>
  <view wx:if="{{!loading && !error}}">
    <view wx:if="{{goals.length}}" class="goal-card" bindtap="review"><view class="tiny">下次目标</view><view wx:for="{{goals}}" wx:key="_id" class="goal-line"><text class="pill-dot"></text>{{item.text}}</view></view>
    <view class="row between section-title"><text>训练历史</text><button class="link" bindtap="projects">线路项目 →</button></view>
    <input wx:if="{{total}}" class="input search" placeholder="搜索岩馆、训练或日期" value="{{query}}" bindinput="search" />
    <view wx:if="{{!total}}" class="card empty"><view class="empty-mark">↗</view><view class="empty-title">暂无训练记录</view><view class="empty-copy">选一家岩馆，留下你的第一次攀迹。</view></view>
    <view wx:elif="{{!sessions.length}}" class="card empty"><view class="empty-title">没有找到对应记录</view><view class="muted">试试其他关键词。</view></view>
    <view wx:for="{{sessions}}" wx:key="_id" class="card session-card" data-id="{{item._id}}" bindtap="open">
      <view class="row between"><view class="date-label">{{item.dateLabel}}</view><text class="tiny">{{item.yearLabel}}</text></view>
      <view class="card-title session-gym">{{item.gymSnapshot.name}} <text class="arrow">↗</text></view>
      <view class="row wrap"><text class="badge">{{item.durationMinutes === null ? '时长待补充' : item.durationMinutes + ' 分钟'}}</text><text class="muted">{{item.attempts}} 次尝试 · {{item.completed}} 次完成</text></view>
      <view wx:if="{{item.trainingNotes}}" class="note-preview">{{item.trainingNotes}}</view>
      <view wx:if="{{item.videos}}" class="tiny spaced">▸ {{item.videos}} 段攀爬视频</view>
    </view>
    <view wx:if="{{unlinked}}" class="notice" bindtap="videos">有 {{unlinked}} 段视频等待整理 →</view>
  </view>
</view>
