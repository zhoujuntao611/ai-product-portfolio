.project-title{word-break:break-word;margin-top:20rpx}.project-metrics{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;padding:32rpx 0}.project-metrics .metric{font-size:44rpx}.project-metrics .stat-label{margin-top:6rpx}.project-note{background:#edf2e7}.project-note .spaced{margin-top:12rpx}.project-edit-notes{height:160rpx}.history-head{padding-bottom:12rpx}.history-attempt{padding:22rpx 0;border-top:1rpx solid #edf0e8}.history-attempt:last-child{padding-bottom:0}.history-grade{font-size:25rpx;margin-left:18rpx}.delete-project{display:block!important;margin:36rpx auto 0;color:#a38e7a!important}
