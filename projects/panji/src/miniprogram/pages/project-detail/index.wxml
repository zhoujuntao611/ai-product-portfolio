<view class="page">
  <view wx:if="{{loading}}" class="notice">正在读取线路…</view><view wx:if="{{error}}" class="error-box">{{error}}<button class="link" bindtap="reload">重试</button></view>
  <block wx:if="{{project && !error}}">
    <view class="row between"><view class="eyebrow">{{project.gymName}}</view><button class="link" bindtap="edit">编辑</button></view><view class="page-title project-title">{{project.routeLabel}}</view>
    <view class="row wrap"><text class="badge">{{project.gradeLabel || '未填难度'}} · {{project.gradeSystem}}</text><button class="link" bindtap="status" disabled="{{busy}}">{{project.statusLabel}} ▾</button></view>
    <view class="project-metrics"><view><view class="metric">{{project.sessionCount}}</view><view class="stat-label">次训练</view></view><view><view class="metric">{{project.attemptCount}}</view><view class="stat-label">次尝试</view></view><view><view class="metric">{{project.completedCount}}</view><view class="stat-label">次完成</view></view></view>
    <view wx:if="{{project.notes}}" class="card project-note"><view class="tiny">线路备注</view><view class="body-copy spaced">{{project.notes}}</view></view>
    <view wx:if="{{formOpen}}" class="card" id="project-edit"><view class="row between"><view class="card-title">更新线路项目</view><button class="link" bindtap="close" disabled="{{busy}}">取消</button></view><view class="label">线路标识 *</view><input class="input" maxlength="80" value="{{form.routeLabel}}" data-field="routeLabel" bindinput="field" /><view class="label">难度原标签</view><input class="input" maxlength="30" value="{{form.gradeLabel}}" data-field="gradeLabel" bindinput="field" /><view class="label">线路备注</view><textarea class="textarea project-edit-notes" maxlength="1000" value="{{form.notes}}" data-field="notes" bindinput="field" placeholder="下次想调整什么？" /><view class="hint">项目修改不会重写历史尝试中的线路和难度。</view><button class="primary full-width spaced" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存修改</button></view>
    <button class="primary full-width" bindtap="record" disabled="{{project.status === 'archived' || busy}}">{{project.status === 'archived' ? '恢复为“下次继续”后可记录' : '记录一次尝试'}}</button>
    <button wx:if="{{project.videoCount}}" class="secondary full-width spaced" bindtap="videos">回看 {{project.videoCount}} 段项目视频 →</button>
    <view class="row between section-title"><text>每一次靠近</text><text class="tiny">按训练串起</text></view>
    <view wx:if="{{!history.length}}" class="card empty"><view class="empty-title">从下一次尝试开始</view><view class="empty-copy">记录尝试时，选择关联这条线路项目。<view>同名线路不会自动归入。</view></view></view>
    <view wx:for="{{history}}" wx:key="sessionId" wx:for-item="entry" class="card history-card"><view class="row between history-head"><text class="card-title">{{entry.session.sessionDate}}</text><button class="link" data-id="{{entry.session._id}}" bindtap="openSession">查看训练 →</button></view><view wx:for="{{entry.attempts}}" wx:key="_id" class="history-attempt"><view class="row between"><view class="grow"><text class="tiny">第 {{item.ordinal}} 次</text><text class="history-grade">{{item.gradeLabel || '未填难度'}}</text></view><text class="badge {{item.result === 'failed' ? 'warm' : ''}}">{{item.resultLabel}}</text></view><view wx:if="{{item.notes}}" class="body-copy spaced">{{item.notes}}</view><view wx:if="{{item.videoCount}}" class="tiny spaced">关联 {{item.videoCount}} 段视频</view></view></view>
    <view class="hint">“已完成”由你手动标记；尝试中的完成次数按原始记录统计。</view><button class="link delete-project" bindtap="remove" disabled="{{busy}}">删除线路项目</button>
  </block>
</view>
