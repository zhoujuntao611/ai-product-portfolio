.profile-card{display:flex;align-items:center;gap:22rpx;margin:36rpx 0 24rpx}.profile-mark{width:94rpx;height:94rpx;border-radius:28rpx;background:#214e41;color:#d3ddc8;display:flex;align-items:center;justify-content:center;font-size:43rpx;font-weight:300}.count-strip{display:flex;justify-content:space-around;padding:24rpx 5rpx 38rpx}.count-strip>view{display:flex;flex-direction:column;align-items:center;gap:5rpx}.count-number{font-size:46rpx;font-weight:600}.usage-track{height:12rpx;background:#edf0e7;border-radius:10rpx;overflow:hidden;margin:24rpx 0}.usage-fill{height:100%;background:#8ca480;border-radius:10rpx}.delete-text{color:#a56648}.about{text-align:center;font-size:23rpx;color:#7b8d7a;line-height:2.1;padding:30rpx 0}
.storage-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:32rpx 0 15rpx}.storage-cell{display:flex;align-items:center;gap:24rpx;background:#e9efe5;border-radius:24rpx;padding:26rpx 24rpx;font-size:25rpx}.storage-location{font-size:30rpx;font-weight:650;color:#214b40;margin-top:4rpx}.storage-icon{position:relative;flex-shrink:0;color:#547561}.storage-phone{width:29rpx;height:45rpx;border:3rpx solid #547561;border-radius:7rpx;margin:0 6rpx}.storage-phone::after{content:'';position:absolute;left:7rpx;right:7rpx;bottom:5rpx;border-top:3rpx solid #547561}.storage-cloud{height:27rpx;width:46rpx;border:3rpx solid #547561;border-radius:18rpx;margin-top:12rpx}.storage-cloud::before{content:'';position:absolute;width:25rpx;height:25rpx;border:3rpx solid #547561;border-bottom:0;border-radius:50% 50% 0 0;background:#e9efe5;top:-17rpx;left:7rpx}.storage-note{font-size:23rpx;color:#718272;padding:4rpx 2rpx 12rpx}.count-strip{padding-top:30rpx}.list-row{padding:30rpx 0}

.storage-grid{gap:14rpx;margin-top:22rpx}.storage-cell{padding:24rpx 20rpx;border-radius:22rpx;gap:20rpx}.storage-note{font-size:22rpx}.count-strip{padding:24rpx 0 28rpx}.count-number{font-size:40rpx}.list-row{padding:24rpx 0}.list-row .tiny{margin-top:5rpx}.about{font-size:22rpx}
