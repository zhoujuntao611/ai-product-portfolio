<view class="page">
  <view class="page-title">我的</view>
  <view wx:if="{{error}}" class="error-box">{{error}}<button class="link" bindtap="reload">重新连接</button></view><view wx:if="{{loading}}" class="notice">正在读取个人记录…</view>
  <block wx:if="{{!loading && !error}}">
    <view class="storage-grid"><view class="storage-cell"><view class="storage-icon {{local ? 'storage-phone' : 'storage-cloud'}}"></view><view><view>训练记录</view><view class="storage-location">{{local ? '本机' : '云端'}}</view></view></view><view class="storage-cell"><view class="storage-icon storage-phone"></view><view><view>视频</view><view class="storage-location">当前设备</view></view></view></view>
    <view class="storage-note">{{local ? '本机内容换机或清缓存可能丢失，建议先导出。' : '视频不跨设备同步，请保留相册原片。'}}</view>
    <view class="count-strip"><view><text class="count-number">{{counts.sessions}}</text><text class="tiny">次训练</text></view><view><text class="count-number">{{counts.videos}}</text><text class="tiny">段视频</text></view><view><text class="count-number">{{counts.reviews}}</text><text class="tiny">次复盘</text></view></view>
    <view class="card"><view class="list-row" bindtap="gyms"><view>我的岩馆</view><text class="arrow">›</text></view><view class="list-row" bindtap="projects"><view>线路项目<view class="tiny">跨训练追踪尝试、卡点和视频</view></view><text class="arrow">›</text></view><view class="list-row" bindtap="videos"><view>视频库</view><text class="arrow">›</text></view><view class="list-row" bindtap="review"><view>复盘与目标<view class="tiny">{{local ? cloudConfigured ? 'AI 复盘需切换到云端记录' : '数据摘要 · 手写复盘' : capabilities.aiAvailable ? 'AI 已接入 · 文本复盘' : '数据摘要 · AI 暂不可用'}}</view></view><text class="arrow">›</text></view></view>
    <view class="section-title">存储</view><view class="card"><view class="row between"><view>视频用量</view><text class="muted">{{usedLabel}} / {{quotaLabel}} MB</text></view><view class="usage-track"><view class="usage-fill" style="width:{{usedPercent}}%"></view></view><button class="outline small spaced" bindtap="switchMode" loading="{{busy}}" disabled="{{busy}}">{{local ? cloudConfigured ? '开通云端记录' : '云端记录尚未开通' : '切换到本机记录'}}</button><view wx:if="{{pending || deleting}}" class="notice">{{deleting ? '数据正在删除。' : ''}}{{pending}} 段视频待清理。<button class="link" bindtap="cleanup">重试清理</button></view></view>
    <view class="section-title">数据管理</view><view class="card"><view class="list-row" bindtap="export"><view>导出数据</view><text class="arrow">›</text></view><view class="list-row" bindtap="privacy"><view>隐私与 AI</view><text class="arrow">›</text></view><view wx:if="{{aiConsent}}" class="list-row" bindtap="revokeAi"><view>撤回 AI 授权</view><text class="arrow">›</text></view><view class="list-row" bindtap="clearData"><view class="delete-text">删除全部数据</view><text class="arrow">›</text></view></view>
    <view class="about" bindtap="about">攀迹 {{releaseLabel}}</view><button class="link" bindtap="diagnostic">查看视频导入状态</button>
  </block>
</view>
