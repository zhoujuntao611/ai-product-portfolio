.card.spaced{margin-top:30rpx}.picker{font-size:24rpx;padding:20rpx 16rpx;min-height:auto;background:#fff}.preview-record{padding:18rpx 0;border-top:1rpx solid #edf0e8}.preview-record .tiny{line-height:1.9}.observation{padding:16rpx 0}.evidence{display:inline-block;font-size:21rpx;color:#517b54;background:#eff3e8;padding:5rpx 14rpx;margin-top:12rpx;border-radius:12rpx}.sheet{margin-top:14rpx}.label{margin-top:28rpx}

.review-range{margin-top:25rpx}.review-range>.tiny{margin-bottom:10rpx}.review-range .row{gap:12rpx}.review-range picker{flex:1}.review-range .picker{text-align:center;background:#fff;min-height:76rpx;font-size:25rpx;padding:17rpx 12rpx}.review-modes{padding:6rpx;background:#e9ede5;border-radius:20rpx;gap:4rpx;margin:24rpx 0}.review-modes .chip{flex:1;border:0;border-radius:16rpx;white-space:nowrap;padding:16rpx 5rpx;color:#617366}.review-modes .active{background:#fff;color:#214d40;box-shadow:0 2rpx 7rpx rgba(30,60,45,.06)}.input-summary{margin-top:20rpx}.input-summary .card-title{font-size:29rpx}.input-summary .switch-row{padding:20rpx 0 10rpx;border-top:1rpx solid #edf0e8;margin-top:18rpx}.switch-label{font-size:25rpx}.input-summary .hint{font-size:21rpx}.manual-review{height:180rpx}.goal-editor{border-color:#bbcfb8}.goal-reason{height:130rpx}.ai-notice{line-height:1.8}.ai-notice .link{margin-top:8rpx}.ai-hint{padding:0 6rpx 10rpx}
