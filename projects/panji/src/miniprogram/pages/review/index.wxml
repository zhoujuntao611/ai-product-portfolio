<view class="page review-page">
  <view class="row between"><view class="page-title">训练复盘</view><button class="link" bindtap="newGoal">＋ 自定目标</button></view><view class="subtitle">回顾记录，带着一个小目标再出发。</view>
  <view wx:if="{{goalEditor || goalReviewId}}" class="card goal-editor spaced"><view class="row between"><view class="card-title">下次想做什么？</view><button class="link" bindtap="closeGoal" disabled="{{busyGoal}}">取消</button></view><input class="input spaced" value="{{goalText}}" data-field="goalText" bindinput="goalField" maxlength="240" placeholder="例如：每次尝试后记录休息间隔" /><textarea wx:if="{{goalReviewId}}" class="textarea spaced goal-reason" value="{{goalReason}}" data-field="goalReason" bindinput="goalField" maxlength="500" placeholder="选填：如何修改建议，为什么？" /><button class="secondary full-width spaced" bindtap="saveGoal" disabled="{{busyGoal || !goalText}}" loading="{{busyGoal}}">保存下次目标</button></view>
  <view class="review-range"><view class="tiny">回顾范围</view><view class="row"><picker mode="date" value="{{from}}" end="{{today}}" data-field="from" bindchange="date"><view class="picker">{{from}} ⌄</view></picker><text class="tiny">至</text><picker mode="date" value="{{to}}" end="{{today}}" data-field="to" bindchange="date"><view class="picker">{{to}} ⌄</view></picker></view></view>
  <view wx:if="{{loading}}" class="notice">正在整理原始记录…</view><view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view class="chips review-modes"><view class="chip {{mode === 'rule' ? 'active' : ''}}" data-value="rule" bindtap="selectMode">数据摘要</view><view class="chip {{mode === 'manual' ? 'active' : ''}}" data-value="manual" bindtap="selectMode">手写复盘</view><view class="chip {{mode === 'ai' ? 'active' : ''}}" data-value="ai" bindtap="selectMode">AI · 实验</view></view>
  <view wx:if="{{mode === 'manual'}}" class="card"><textarea class="textarea manual-review" value="{{manual}}" bindinput="manual" maxlength="2000" placeholder="有什么发现？下次想怎么调整？" /></view>
  <view wx:if="{{mode === 'ai' && !capabilities.aiAvailable}}" class="notice ai-notice"><view>{{local ? cloudConfigured ? '本机模式不调用 AI。切换到云端记录后，可使用已接入的 AI 复盘。' : 'AI 需先配置云端服务。当前可用数据摘要和手写复盘。' : 'AI 服务暂不可用，可以先使用数据摘要或手写复盘。'}}</view><block wx:if="{{local && cloudConfigured}}"><view class="hint">两处记录分开保存，切换不会自动上传本机记录。</view><button class="link" bindtap="recordSettings">查看云端记录设置 →</button></block></view>
  <view wx:if="{{mode === 'ai' && capabilities.aiAvailable}}" class="hint ai-hint">每天最多 3 次，免费额度用尽后暂停生成。请核对输入；视频不会发送给 AI。</view>
  <view wx:if="{{preview}}" class="card input-summary">
    <view class="row between"><view class="card-title">{{preview.records.length}} 次训练</view><button class="link" bindtap="togglePreview">{{showPreview ? '收起明细 −' : '查看输入 ＋'}}</button></view><view class="muted">已填 {{preview.statistics.minutes}} 分钟 · {{preview.statistics.attempts}} 次尝试<text wx:if="{{preview.statistics.missingDuration}}"> · {{preview.statistics.missingDuration}} 次缺时长</text></view>
    <view class="switch-row"><view class="grow"><view class="switch-label">包含备注与目标反馈</view><view class="tiny">默认不包含，打开后请检查输入。</view></view><switch checked="{{includeNotes}}" color="#1e5147" bindchange="toggleNotes" /></view>
    <block wx:if="{{showPreview}}">
      <view wx:for="{{preview.records}}" wx:key="id" class="preview-record"><view class="row between"><text>{{item.date}}</text><text class="tiny">{{item.gymCode}} · {{item.minutes === null ? '时长未填' : item.minutes + ' 分钟'}}</text></view><view wx:if="{{includeNotes}}" class="muted spaced">训练：{{item.notes || '未填写'}}<br/>感受：{{item.feeling || '未填写'}}</view><view wx:for="{{item.attempts}}" wx:for-item="attempt" wx:key="index" class="tiny">{{attempt.gradeSystem}} / {{attempt.gradeLabel || '未填难度'}} · {{attempt.result === 'completed' ? '完成' : attempt.result === 'failed' ? '未完成' : '未知'}}<text wx:if="{{includeNotes && attempt.notes}}"> · {{attempt.notes}}</text></view></view>
      <view wx:for="{{preview.previousGoals}}" wx:key="index" class="preview-record muted">目标：{{item.text}} · {{item.status}}<br/>反馈：{{item.feedback || '未填写'}}</view>
    </block><view class="hint">不含视频、微信身份和岩馆名称。备注中的个人信息请自行检查。</view>
  </view>
  <button class="primary full-width" bindtap="create" loading="{{busy}}" disabled="{{busy || !preview || (mode === 'ai' && !capabilities.aiAvailable)}}">{{mode === 'ai' ? '确认范围，生成 AI 复盘' : mode === 'manual' ? '保存手写复盘' : '生成数据摘要'}}</button>
  <view wx:if="{{waiting}}" class="notice">{{timeoutHint ? '任务仍可能在云端处理，当前已停止自动等待。可稍后刷新查看。' : '复盘任务已提交，正在等待云端处理。'}}<button class="link" bindtap="refreshJobs">刷新任务状态</button></view>
  <view wx:if="{{goals.length}}" class="section-title">目标与后续核对</view><view wx:for="{{goals}}" wx:key="_id" class="card"><view class="row between"><text class="badge {{item.status === 'active' ? 'warm' : ''}}">{{item.statusLabel}}</text><button wx:if="{{item.status === 'active'}}" class="link" data-id="{{item._id}}" bindtap="cancelGoal">取消目标</button></view><view class="body-copy spaced">{{item.text}}</view><view wx:if="{{item.userFeedback}}" class="muted spaced">反馈：{{item.userFeedback}}</view><button wx:if="{{item.followupSessionId}}" class="link" data-id="{{item.followupSessionId}}" bindtap="source">查看核对训练 →</button><button wx:elif="{{item.status === 'active'}}" class="link" bindtap="followup">如何核对 →</button></view>
  <view class="section-title">回顾留下的痕迹</view><view wx:if="{{!reviews.length}}" class="card empty"><view class="empty-title">还没有保存复盘</view><view class="empty-copy">从一份数据摘要或手写感受开始。</view></view>
  <view wx:for="{{reviews}}" wx:for-item="review" wx:key="_id" class="card">
    <view class="row between"><text class="badge">{{review.modeLabel}}</text><text class="tiny">{{review.statusLabel}}</text></view><view class="tiny spaced">{{review.from}} — {{review.to}}</view>
    <view wx:if="{{review.status === 'stale'}}" class="notice">原始训练已修改或删除，旧复盘内容已清除，请选择范围重新生成。</view>
    <view wx:if="{{review.status === 'failed'}}" class="notice">{{review.errorMessage}} · 可保留原记录，改用数据摘要或手写复盘。</view>
    <block wx:if="{{review.output && review.status === 'ready'}}">
      <view class="body-copy spaced">{{review.output.summary}}</view>
      <view wx:if="{{review.observations.length}}" class="label">记录中的事实</view><view wx:for="{{review.observations}}" wx:for-item="observation" wx:key="index" class="observation"><view class="body-copy">{{observation.text}}</view><view class="row wrap"><text wx:for="{{observation.evidence}}" wx:for-item="evidence" wx:key="id" class="evidence" data-id="{{evidence.id}}" bindtap="source">↗ {{evidence.label}}</text></view></view>
      <view wx:if="{{review.output.hypotheses.length}}" class="label">待核对的推测</view><view wx:for="{{review.output.hypotheses}}" wx:key="index" class="sheet"><view class="body-copy">{{item.text}}</view><view class="muted spaced">依据：{{item.reason}}<br/>不确定性：{{item.uncertainty}}</view></view>
      <view wx:if="{{review.output.actions.length}}" class="label">选择一个下次行动</view><view wx:for="{{review.output.actions}}" wx:key="index" class="sheet"><view class="body-copy">{{item.text}}</view><view class="muted spaced">核对方式：{{item.metric}}</view><view class="muted">{{item.followupQuestion}}</view><button class="outline small spaced" data-review="{{review._id}}" data-text="{{item.text}}" bindtap="chooseGoal">接受 / 修改这个建议</button></view>
      <view wx:for="{{review.output.limitations}}" wx:key="index" class="hint spaced">· {{item}}</view>
      <view wx:if="{{review.feedback}}" class="notice">你的反馈：{{review.feedback}}</view><button class="link spaced" data-id="{{review._id}}" bindtap="reject">不采纳 / 留下反馈</button>
      <view wx:if="{{review.mode === 'ai'}}" class="tiny spaced">AI 生成内容，仅供训练回顾参考。模型 {{review.modelVersion}} · {{review.promptVersion}}</view>
    </block>
    <view class="line"></view><button class="link" data-id="{{review._id}}" bindtap="remove">删除这次复盘</button>
  </view>
</view>
