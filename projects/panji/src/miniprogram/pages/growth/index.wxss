.date-range{gap:14rpx}.date-picker{padding:16rpx 18rpx;background:#fff;border:1rpx solid #e5e9dd;border-radius:14rpx;font-size:23rpx}.gym-filter{padding:22rpx 0;margin-bottom:20rpx;font-size:25rpx;color:#6d846c}.gym-filter text{float:right}.weekly{display:flex;gap:28rpx;min-width:100%;align-items:flex-end;padding:10rpx 5rpx}.week-column{min-width:65rpx;display:flex;flex-direction:column;align-items:center}.bar-track{height:154rpx;display:flex;align-items:flex-end;justify-content:center}.week-bar{width:30rpx;background:#83a27c;border-radius:8rpx 8rpx 3rpx 3rpx}.week-count{font-size:23rpx;color:#4e7153}.week-column .tiny{margin-top:15rpx}.grade-row{padding:22rpx 28rpx}.sheet .label{margin-top:0}
