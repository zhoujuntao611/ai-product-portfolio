.gym-detail-title{font-size:43rpx;margin:22rpx 0 30rpx}.facility-grid{display:flex;flex-wrap:wrap;gap:18rpx}.facility-tile{display:flex;align-items:center;gap:12rpx;background:#edf2e9;border-radius:16rpx;padding:18rpx 25rpx;font-size:28rpx}.facility-dot{width:15rpx;height:15rpx;border-radius:50%;background:#75966b}.source-url{display:block;font-size:23rpx;word-break:break-all;color:#617965;margin-top:18rpx}.card .label{margin-top:0}
.osm-credit{margin-top:30rpx;color:#617965;font-size:22rpx}.osm-credit .link{font-size:23rpx;margin-top:4rpx}.source-item{padding:20rpx 0;border-bottom:1rpx solid #dce5d8}.source-item:last-child{border-bottom:0;padding-bottom:0}.source-item .source-url{margin-top:10rpx}.source-retrieved{padding-bottom:8rpx}
.card .copy-address{font-size:25rpx;padding:0;margin:0 0 14rpx 20rpx}
